# ── Database ──────────────────────────────────────────────────────────────────
# Local dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learnpulse [replace with prod connection string]
DATABASE_SSL=true

# Neon (production) — replace with your Neon connection string
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>.neon.tech/learnpulse?sslmode=require
# DATABASE_SSL=true

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=                         # https://aistudio.google.com/app/apikey
GEMINI_EMBED_MODEL=models/text-embedding-004
GEMINI_CHAT_MODEL=models/gemini-3.5-flash
EMBEDDING_BACKEND=gemini

# ── Optional: HuggingFace embeddings (offline fallback) ──────────────────────
HF_EMBED_MODEL=BAAI/bge-m3
HF_EMBED_DEVICE=cpu
HYBRID_WEIGHT=0.6

# ── Storage paths (relative to repo root) ────────────────────────────────────
CHROMA_DIR=backend/data/chroma
KG_PATH=backend/data/kg/graph.json
UPLOAD_DIR=backend/data/uploads

# ── CORS ──────────────────────────────────────────────────────────────────────
# Production: replace * with your Vercel URL
# CORS_ORIGINS=["https://your-app.vercel.app"]
CORS_ORIGINS=["*"]

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production  # openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080                # 7 days
GOOGLE_CLIENT_ID=                       # Google Cloud Console → OAuth 2.0 Client IDs

# ── Google Cloud Text-to-Speech ───────────────────────────────────────────────
# Path to a service account JSON (keep the JSON file out of git; see .gitignore)
GOOGLE_TTS_KEY_PATH=backend/secrets/google-tts-service-account.json
